# React 19 peer ranges across the Expo/jest/testing-library stack are noisy;
# without this, npm silently SKIPS extracting peer-conflicting devDeps (jest-expo,
# @testing-library/react-native, react-test-renderer) and the lock bakes the skip
# in. legacy-peer-deps keeps installs isolated to this standalone package's
# node_modules (the bun-workspace root does NOT list maestro-mobile).
legacy-peer-deps=true
