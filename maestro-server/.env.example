# ================================
# Maestro Server Configuration
# ================================
# Copy this file to .env and modify as needed

# Server
PORT=3000
HOST=0.0.0.0
SERVER_URL=http://localhost:3000

# Storage Directories
# Paths support ~ for home directory
DATA_DIR=~/.maestro/data
SESSION_DIR=~/.maestro/sessions
SKILLS_DIR=~/.agents-ui/maestro-skills

# Database
# Type: filesystem (default) or postgres
DATABASE_TYPE=filesystem
# DATABASE_URL=postgres://user:password@localhost:5432/maestro

# Manifest Generator
# Type: cli (default) or server
MANIFEST_GENERATOR=cli
MAESTRO_CLI_PATH=maestro

# CORS
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
# LOG_FILE=/var/log/maestro/server.log

# Environment
NODE_ENV=development
DEBUG=false

# Collab V2 façade (public Supabase endpoint/key only; never a service-role key)
# MAESTRO_SUPABASE_URL=https://<project-ref>.supabase.co
# MAESTRO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
# TEST ONLY: trusts a caller-supplied Firebase UID. Never enable in production.
# MAESTRO_COLLAB_V2_INSECURE_UID_BYPASS=false
