# /etc/maestro/gateway.env — Trusted-Team Hub gateway config for the VPS.
# Copy to /etc/maestro/gateway.env and adjust. Two phases below.

# ── Gateway HTTP (Tailscale serve fronts 443 -> this loopback port) ──
MAESTRO_GATEWAY_PORT=4580
MAESTRO_GATEWAY_HOST=127.0.0.1

# ── Per-user workspaces + instance ports ──
MAESTRO_HUB_DIR=/home/ubuntu/hub
MAESTRO_INSTANCE_PORT_START=4600
MAESTRO_INSTANCE_PORT_END=4699

# ── How to launch a per-user maestro-server instance ──
# All instances share this ONE built checkout + node_modules (incl. the linux
# node-pty binary already fixed on the box). Only DATA_DIR/SESSION_DIR differ.
MAESTRO_SERVER_ENTRY=/home/ubuntu/agent-maestro/maestro-server/dist/server.js
MAESTRO_SERVER_CWD=/home/ubuntu/agent-maestro
MAESTRO_UI_DIST=/home/ubuntu/agent-maestro/maestro-ui/dist
MAESTRO_NODE_BIN=/usr/bin/node

# ── Shared pooled subscription (A10) — same logged-in config every instance uses ──
CLAUDE_CONFIG_DIR=/home/ubuntu/.claude
# CODEX_HOME=/home/ubuntu/.codex   # set once a shared Codex login exists on the box

NODE_ENV=production
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — safe bring-up on Tailscale, no Firebase yet. Test on-box with curl:
#   curl -H "x-maestro-uid: tester1" http://127.0.0.1:4580/api/projects
# DEV auth trusts the x-maestro-uid header — ONLY acceptable because the box is
# tailnet-only and the gateway binds loopback. Do NOT expose publicly in this mode.
MAESTRO_GATEWAY_AUTH=dev
MAESTRO_ENFORCE_ALLOWLIST=false

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 2 — real identity (uncomment, remove the Phase 1 two lines above):
#   1) bun add firebase-admin (in maestro-gateway) or `bun install` after it's a dep
#   2) drop a service-account JSON at /etc/maestro/firebase-sa.json (chmod 600)
#   3) create /home/ubuntu/hub/allowlist.json  => {"emails":["you@gmail.com", ...]}
# MAESTRO_GATEWAY_AUTH=firebase
# MAESTRO_FIREBASE_PROJECT_ID=maestro-5f3fc
# MAESTRO_FIREBASE_CREDENTIALS=/etc/maestro/firebase-sa.json
# MAESTRO_ENFORCE_ALLOWLIST=true
