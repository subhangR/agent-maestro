{
  "name": "maestro-gateway",
  "version": "1.0.0",
  "description": "Trusted-Team Hub gateway — process-per-user Maestro (Design A). Verifies each user's Firebase login, spawns/owns a maestro-server instance per uid, and reverse-proxies /api /ws /pty to it.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "watch": "tsc --watch"
  },
  "keywords": [
    "maestro",
    "gateway",
    "multi-user"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "express": "^5.2.1",
    "http-proxy": "^1.18.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
