{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestro public website content",
  "type": "object",
  "required": ["schemaVersion", "productName", "eyebrow", "heroDescription", "installCommand"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "productName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "eyebrow": { "type": "string", "minLength": 1, "maxLength": 100 },
    "heroDescription": { "type": "string", "minLength": 1, "maxLength": 320 },
    "installCommand": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "additionalProperties": false
}
