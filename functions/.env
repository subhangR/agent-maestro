# The default Maestro Firebase project's regional RTDB instance. This is a
# public endpoint, not a credential. Override it per deployment as needed.
MAESTRO_RTDB_URL=https://maestro-5f3fc-default-rtdb.asia-southeast1.firebasedatabase.app

# Website contact form email notification (non-secret). The Gmail App Password
# is stored separately as the CONTACT_MAIL_PASS Functions secret.
CONTACT_MAIL_USER=manzilshaik95@gmail.com
CONTACT_MAIL_TO=manzilshaik95@gmail.com

# Placeholder — override with your real Gmail App Password in the git-ignored
# functions/.env.maestro-5f3fc, then redeploy. While "PENDING", email is skipped.
