    {"type":"text","id":"flow-note","x":40,"y":985,"width":1100,"height":40,"text":"Session spawn flow:  UI POST /sessions/spawn  -->  SessionService builds MaestroManifest  -->  EventBus emits session:spawn_request  -->  WebSocketBridge pushes event  -->  Tauri spawns terminal with manifest path  -->  CLI worker-init reads manifest, composes prompt (PromptComposer + identity/commands/spawner)  -->  Claude starts","fontSize":13,"fontFamily":1,"strokeColor":"#4a5568"}
