      "link": null,
      "locked": false,
      "text": "Key invariant: the system-prompt memory block is captured ONCE at session start.\nLive writes go to disk + next session's snapshot, NOT the current prompt \u2014 this keeps\nthe LLM prefix cache intact for the whole session.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key invariant: the system-prompt memory block is captured ONCE at session start.\nLive writes go to disk + next session's snapshot, NOT the current prompt \u2014 this keeps\nthe LLM prefix cache intact for the whole session.",
