{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestro architecture manifest",
  "type": "object",
  "required": ["frontends", "backends", "interfaces", "shared", "operations", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "frontends": { "$ref": "#/$defs/paths" },
    "backends": { "$ref": "#/$defs/paths" },
    "interfaces": { "$ref": "#/$defs/paths" },
    "shared": { "$ref": "#/$defs/paths" },
    "operations": { "$ref": "#/$defs/paths" },
    "rules": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
