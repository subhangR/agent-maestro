{
  "description": "Maestro Worker hooks for server integration",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=1 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session register",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session complete",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session needs-input",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session needs-input",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session resume-working",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/track-file",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli hook dispatch PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session needs-input",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "MAESTRO_RETRIES=0 MAESTRO_API_TIMEOUT=8000 ${CLAUDE_PLUGIN_ROOT}/bin/maestro-cli session needs-input",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
